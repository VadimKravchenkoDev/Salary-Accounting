<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/calculatorFragment">

    <fragment
        android:id="@+id/calculatorFragment"
        android:name="com.arhizmei.salaryaccounting.ui.calculator.CalculatorFragment"
        android:label="Calculator">

        <action
            android:id="@+id/action_calculatorFragment_to_resultCalculatorFragment"
            app:destination="@id/resultCalculatorFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultCalculatorFragment"
        android:name="com.arhizmei.salaryaccounting.ui.calculator.ResultCalculatorFragment"
        android:label="ResultCalculator" />


    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.arhizmei.salaryaccounting.ui.calendar.CalendarFragment" />
    <fragment
        android:id="@+id/shiftsFragment"
        android:name="com.arhizmei.salaryaccounting.ui.shifts.ShiftsFragment" />
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.arhizmei.salaryaccounting.ui.statistics.StatisticsFragment" />

</navigation>